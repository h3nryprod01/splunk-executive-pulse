# Splunk MCP Server (Signal Collector + Business Enricher MCP lookups)
SPLUNK_MCP_URL=http://localhost:8089
SPLUNK_MCP_TOKEN=dev-token

# Business context Postgres (production path; demo uses in-memory CSV store)
PG_DSN=postgresql://localhost/pulse

# Splunk Hosted Models — PRIMARY LLM for the Narrative Writer
SPLUNK_LLM_ENDPOINT=
SPLUNK_LLM_TOKEN=

# LLM fallback only ("anthropic" | "openai") when hosted model is unavailable
LLM_FALLBACK=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# TTS (Audio Producer)
ELEVENLABS_API_KEY=
